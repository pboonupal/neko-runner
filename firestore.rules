rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Neko Runner scores: anyone can read the board and add one score.
    // Nobody can edit or delete a score from the game.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'date'])
        && request.resource.data.keys().hasAll(['name', 'score', 'date'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.date == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
